---
import { catalog } from '../../lib/catalog';
import { pathAtBase } from '../../lib/urls.mjs';
import { chaosTreatment } from '../../lib/content.mjs';
import Listening from '../shared/Listening.astro';
import presentation from '../../data/presentation.json';
const { entries, posts, projects: allProjects } = await catalog();
const projects = allProjects.filter(e => presentation.labyrinthProjects.includes(e.id)).map(e => ({ ...e, type: 'Project', path: `/projects/${e.id}/` }));
const additional = entries.filter(e => e.type === 'Project' && !presentation.labyrinthProjects.includes(e.id));
const personal = entries.filter(e => e.type === 'Personal');
const other = entries.filter(e => e.type === 'Experience' || e.type === 'Writing');
const href = (path: string) => pathAtBase(path, import.meta.env.BASE_URL);
---
<section class="labyrinth" aria-label="A typographic landscape of work and curiosities">
  <div class="labyrinth-intro"><p>Projects, work, and notes</p><span>Scroll to explore.</span></div>
  <div class:list={['labyrinth-landscape', { 'has-personal': personal.length > 0 }]}> 
    <div class="maze-rails" aria-hidden="true"></div>
    <div class="maze-title" aria-hidden="true"><span>FOLLOW</span><span>YOUR</span><span>CURIOSITY</span></div>
    {projects.map((entry, i) => {
      const treatment = chaosTreatment(entry.data, i);
      return <a href={href(entry.path)} class={`maze-object maze-project object-${i} geometry-${treatment.geometry} palette-${treatment.palette} scale-${treatment.scale}`} style={`--rotation:${treatment.rotation}deg`}><span class="object-kind">{entry.type} · {entry.data.technologies.slice(0, 2).join(' / ')}</span><strong>{entry.data.title}</strong><span class="object-caption">{entry.data.summary}</span>{treatment.artwork && <img class="chaos-artwork" src={href(treatment.artwork)} alt="" width="360" height="240" loading="lazy" />}</a>;
    })}
    <div class="maze-ring" aria-hidden="true"><span>PROJECTS · RESEARCH · PROJECTS · RESEARCH ·</span></div>
    <a class="maze-blog" href={href('/blog/')}><span class="eyebrow">Blog</span><strong>NOTES<br />TO SELF.</strong><span>{posts.length ? `${posts.length} published ${posts.length === 1 ? 'piece' : 'pieces'}` : 'Blog · Nothing published yet.'}</span></a>
    <div class="maze-stair" aria-hidden="true"><span>KEEP</span><span>ASKING</span><span>WHY.</span></div>
    {personal.length > 0 && <div class="maze-personal">{personal.slice(0, 3).map(entry => <a href={href(entry.path)}><span class="eyebrow">Personal{entry.data.placeholder ? ' · Placeholder' : ''}</span><strong>{entry.data.title}</strong><span>{entry.data.summary}</span></a>)}</div>}
    <div class="maze-exit"><span>More projects and experience below.</span><a href={href('/projects/')}>Explore all projects</a></div>
  </div>
  <div class="maze-music"><div class="record" aria-hidden="true"><span>33⅓</span></div><Listening /></div>
  <div class="maze-continuation">{[...additional, ...other, ...personal.slice(3)].map((entry, i) => {
    const treatment = chaosTreatment(entry.data, i);
    return <a class={`geometry-${treatment.geometry} palette-${treatment.palette} scale-${treatment.scale}`} style={`--rotation:${treatment.rotation}deg`} href={href(entry.path)}><span class="eyebrow">{entry.type}{entry.type === 'Experience' && entry.data.status === 'incoming' ? ' · Incoming' : ''}{entry.data.placeholder ? ' · Placeholder' : ''}</span><strong>{entry.data.title}</strong><span>{entry.data.summary}</span></a>;
  })}</div>
</section>
