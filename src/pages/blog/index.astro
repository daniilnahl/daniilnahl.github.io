---
import Site from '../../layouts/Site.astro';
import { catalog } from '../../lib/catalog';
const { posts } = await catalog();
const tags = [...new Set(posts.flatMap(p => p.data.tags))];
---
<Site title="Blog" canonicalPath="/blog/">
  <div class="page-heading"><p class="eyebrow">Blog</p><h1>Notes</h1><p>I'll post about projects and things I'm learning here.</p></div>
  {posts.length ? <>
    {tags.length > 0 && <nav class="tag-links" aria-label="Writing by topic">{tags.map(tag => <a href={`#tag-${tag}`}>{tag.replaceAll('-', ' ')}</a>)}</nav>}
    <div class="post-list">{posts.map(post => <article><time datetime={post.data.published.toISOString()}>{post.data.published.toLocaleDateString('en-US', { dateStyle: 'medium', timeZone: 'UTC' })}</time><h2><a href={`${import.meta.env.BASE_URL}blog/${post.id}/`}>{post.data.title}</a></h2><p>{post.data.summary}</p></article>)}</div>
    {tags.map(tag => <section id={`tag-${tag}`} class="tag-section"><h2>{tag.replaceAll('-', ' ')}</h2><ul>{posts.filter(p => p.data.tags.includes(tag)).map(p => <li><a href={`${import.meta.env.BASE_URL}blog/${p.id}/`}>{p.data.title}</a></li>)}</ul></section>)}
  </> : <div class="blog-empty"><span class="empty-glyph" aria-hidden="true">Aa<span>…</span></span><div><h2>Nothing published yet.</h2><a href={`${import.meta.env.BASE_URL}rss.xml`} data-no-mode>RSS feed</a></div></div>}
</Site>
